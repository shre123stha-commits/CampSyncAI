# ---------- Backend ----------
OLLAMA_BASE_URL=http://localhost:11434
PLANNING_MODEL=qwen2.5:3b
EXTRACTION_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0
LLM_MAX_RETRIES=2

# ---------- Scheduling ----------
COLLEGE_START=08:00
COLLEGE_END=16:00
STUDY_DAY_END=22:00
MIN_STUDY_SLOT_MINUTES=30

# ---------- Logging ----------
LOG_LEVEL=INFO

# ---------- Frontend ----------
BACKEND_URL=http://127.0.0.1:8000
BACKEND_TIMEOUT=180

# ---------- Caching ----------
CACHE_ENABLED=true
CACHE_DIR=backend/.cache

# ---------- Database & auth ----------
DATABASE_URL=sqlite:///backend/campussync.db
SESSION_TTL_HOURS=12
UPLOAD_DIR=backend/data/uploads
MAX_UPLOAD_BYTES=5242880

# ---------- Secrets ----------
# REQUIRED in production. Rotating this invalidates stored source credentials.
SECRET_KEY=

# ---------- Google Classroom (optional) ----------
# Create an OAuth client at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/sources/classroom/callback

# --- Model provider -------------------------------------------------------
# "ollama" keeps inference local; "openai" targets any OpenAI-compatible API
# so users do not each need Ollama installed.
LLM_PROVIDER=ollama
OPENAI_API_KEY=
OPENAI_BASE_URL=
LLM_TIMEOUT_SECONDS=120

# --- Microsoft Teams ------------------------------------------------------
# See docs/MICROSOFT_TEAMS_SETUP.md. EduAssignments.ReadBasic needs tenant
# admin consent; the adapter falls back to the calendar without it.
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:8000/sources/teams/callback
MS_TENANT=common

# --- Postgres (docker-compose.prod.yml) -----------------------------------
POSTGRES_USER=campussync
POSTGRES_PASSWORD=
POSTGRES_DB=campussync
