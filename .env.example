# ---------- Backend ----------
OLLAMA_BASE_URL=http://localhost:11434
PLANNING_MODEL=qwen2.5:3b
EXTRACTION_MODEL=qwen2.5:3b
LLM_TEMPERATURE=0
LLM_MAX_RETRIES=2

# ---------- Scheduling ----------
COLLEGE_START=08:00
COLLEGE_END=16:00
STUDY_DAY_END=22:00
MIN_STUDY_SLOT_MINUTES=30

# ---------- Logging ----------
LOG_LEVEL=INFO

# ---------- Frontend ----------
BACKEND_URL=http://127.0.0.1:8000
BACKEND_TIMEOUT=180

# ---------- Caching ----------
CACHE_ENABLED=true
CACHE_DIR=backend/.cache

# ---------- Database & auth ----------
DATABASE_URL=sqlite:///backend/campussync.db
SESSION_TTL_HOURS=12
UPLOAD_DIR=backend/data/uploads
MAX_UPLOAD_BYTES=5242880
